    "directory": "packages/chatbotlite-mcp"
  },
  "bugs": "https://github.com/agents-io/chatbotlite/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatbot",
    "ai",
    "llm",
    "claude-code",
    "cursor",
    "cline",
    "scaffold",
    "chatbotlite",
    "react",
    "widget",
    "openai",
    "groq"
  ],
  "type": "module",
  "bin": {
    "chatbotlite-mcp": "./dist/index.js"
