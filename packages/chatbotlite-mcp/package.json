{
  "name": "chatbotlite-mcp",
  "version": "0.1.0",
  "description": "MCP server for ChatbotLite. Lets AI coding agents (Claude Code, Cursor, Cline) scaffold a drop-in AI chatbot for any website, discover the 10 LLM providers, and look up the 13 URL-only adapters.",
  "license": "Apache-2.0",
  "author": "agents.io",
  "homepage": "https://github.com/agents-io/chatbotlite",
